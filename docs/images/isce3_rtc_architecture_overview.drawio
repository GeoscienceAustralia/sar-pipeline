        <mxCell id="stage2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;fontSize=14;spacingLeft=10;spacingTop=10;spacingRight=10;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;rtc_s1.py $RUN_CONFIG_PATH&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Loads the run-config, which points to the downloaded scene, orbit, DEM and the sensor-mode-specific burst-database&lt;br&gt;• Runs the ISCE3 RTC process: radiometric and geometric terrain correction, per burst&lt;br&gt;• Assigns each burst to the common geogrid defined by the burst-database&lt;br&gt;• Writes burst rasters and ancillary static layers to the output folder for the next stage&lt;/font&gt;" vertex="1">
          <mxGeometry height="343" width="490" x="1072" y="587" as="geometry" />
        </mxCell>
        <mxCell id="stage3Header" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="conda activate sar-pipeline" vertex="1">
          <mxGeometry height="34" width="660" x="1540" y="547" as="geometry" />
        </mxCell>
        <mxCell id="wtEKbDg2mfdxs0xIVsQH-5" edge="1" parent="1" source="stage3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fillColor=#009900;strokeColor=#009900;" target="success0">
          <mxGeometry relative="1" as="geometry" />
