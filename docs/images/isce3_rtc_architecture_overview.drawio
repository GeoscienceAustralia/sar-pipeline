        <mxCell id="wtEKbDg2mfdxs0xIVsQH-11" edge="1" parent="1" source="stage3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF3333;" target="fail3Label">
          <mxGeometry relative="1" as="geometry" />
